# ==========================================================
# GESTOR REDLINE — ARQUIVO DE CONFIGURAÇÃO DE EXEMPLO
# Copie este arquivo para .env e preencha com suas credenciais:
# cp .env.example .env
# ==========================================================

# --- BOT DO DISCORD ---
# Obtenha em: https://discord.com/developers/applications
DISCORD_TOKEN=seu_discord_bot_token_aqui

# ID do Servidor Discord principal onde o bot e os comandos vão atuar
GUILD_ID=seu_id_do_servidor_discord_aqui

# --- GOOGLE FIREBASE ---
# Obtenha em: Firebase Console > Configurações do Projeto > Seus Aplicativos
FIREBASE_API_KEY=sua_firebase_api_key_aqui
FIREBASE_PROJECT_ID=seu_firebase_project_id_aqui
FIREBASE_APP_ID=seu_firebase_app_id_aqui
FIREBASE_MESSAGING_SENDER_ID=seu_messaging_sender_id_aqui

# --- (OPCIONAL) IDs DE CANAIS E CARGOS DO DISCORD ---
# Caso prefira configurar via .env em vez de editar o CONFIG no index.js:
# CHANNEL_ID=1253003446244610108          # Canal do painel fixo
# MESSAGE_ID=1467192047231566049          # ID da mensagem fixa do painel
# BASE_ROLE_ID=1252997989144727719        # Cargo base de membro
# REPORT_CHANNEL_ID=1238572013707329718   # Canal onde relatórios são enviados
# RECRUIT_CHANNEL_ID=1257816172154458253  # Canal de registros de recrutamento
# SPONSOR_CHANNEL_ID=1252997990168395924  # Canal de patrocínios/doações
# AVISOS_CHANNEL_ID=1252997990491361401   # Canal de avisos gerais
# TOP_HOURS_ROLE_ID=1252997989170155536   # Cargo atribuído ao Top Horas
# TOP_RECRUITER_ROLE_ID=1425465043155419156 # Cargo atribuído ao Top Recrutador
# BOOSTER_ROLE_ID=1253014613428277259     # Cargo atribuído a Boosters
# SALES_LOG_CHANNEL_ID=1238572013321322546# Canal de logs de vendas em tempo real
# ADMIN_LOG_ID=943628403528056923         # ID de usuário do Dono/Admin para logs em DM
# IGNORED_USERS=713774125151289385        # IDs de usuários ignorados (separados por vírgula)
